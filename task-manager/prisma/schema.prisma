generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Task {
  id           String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name         String
  dueDate      DateTime
  responsible  String?
  category     String?
  notes        String?
  links        String?
  priority     String?  @default("medium")
  userId       String
  lastUpdated  DateTime @default(now()) @updatedAt
  createdAt    DateTime @default(now())
  teamId       String?
  assignedToId String?
  createdById  String?
  completed    Boolean  @default(false)
  orderIndex   Int      @default(0)
  status       String   @default("todo")
  recurrence   String?
  nextRecurrenceDate DateTime?
  isTemplate   Boolean  @default(false)
  description  String?
  projectId    String?

  labels       TaskLabel[]
  comments     TaskComment[]
  subtasks     Subtask[]
  attachments  Attachment[]

  @@index([userId])
  @@index([dueDate])
  @@index([assignedToId])
  @@index([teamId])
}

model Note {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  content   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Team {
  id          String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([ownerId])
}

model TeamMember {
  id          String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  teamId      String
  userId      String?
  userEmail   String
  role        String    @default("member")
  status      String    @default("pending")
  invitedBy   String
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([teamId, userId], map: "TeamMember_teamId_userId_unique")
  @@index([teamId])
  @@index([userId])
  @@index([status])
}

model Profile {
  id                     String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId                 String   @unique
  name                   String?
  avatar                 String?
  bio                    String?
  avatarUrl              String?
  hasCompletedOnboarding Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now())
}

model Label {
  id        String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name      String
  color     String      @default("#3b82f6")
  userId    String
  createdAt DateTime    @default(now())
  
  tasks     TaskLabel[]

  @@index([userId])
}

model TaskLabel {
  taskId  String
  labelId String
  
  task    Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
}

model TaskComment {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model Subtask {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  taskId    String
  content   String
  completed Boolean  @default(false)
  orderIndex Int     @default(0)
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Project {
  id          String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name        String
  description String?
  teamId      String?
  ownerId     String
  color       String   @default("#6366F1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([teamId])
}

model TaskDependency {
  id        String @id @default(dbgenerated("(uuid_generate_v4())::text"))
  blockerId String
  blockedId String

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model TimeEntry {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  taskId    String
  userId    String
  minutes   Int
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

model Attachment {
  id           String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileSize     Int
  mimeType     String
  storagePath  String
  createdAt    DateTime @default(now())
  uploadedById String

  @@index([taskId])
}
